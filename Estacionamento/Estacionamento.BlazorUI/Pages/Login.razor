@page "/login"

@inject NavigationManager Navigation

<h3>Login</h3>

@if (!string.IsNullOrEmpty(erro))
{
    <div class="alert alert-danger">@erro</div>
}

<EditForm Model="@usuario" OnValidSubmit="ValidarLogin">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label>Usuário</label>
        <InputText class="form-control" @bind-Value="usuario.Login" />
    </div>

    <div class="mb-3">
        <label>Senha</label>
        <InputText class="form-control" type="password" @bind-Value="usuario.Senha" />
    </div>

    <button type="submit" class="btn btn-primary">Entrar</button>
</EditForm>

@code {
    private UsuarioLogin usuario = new();
    private string? erro;

    private void ValidarLogin()
    {
        if (usuario.Login == "est" && usuario.Senha == "est")
        {
            erro = null;
            Navigation.NavigateTo("/estacionamento");
        }
        else
        {
            erro = "Usuário ou senha inválidos.";
        }
    }

    public class UsuarioLogin
    {
        public string Login { get; set; } = string.Empty;
        public string Senha { get; set; } = string.Empty;
    }
}

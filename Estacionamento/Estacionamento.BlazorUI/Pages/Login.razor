@page "/login"
@inject NavigationManager Navigation

<h3>Login</h3>

@if (!string.IsNullOrEmpty(erro))
{
    <div style="color:#b00020; margin-bottom:10px">@erro</div>
}

<EditForm Model="@usuario" OnValidSubmit="ValidarLogin">
    <DataAnnotationsValidator />
    <div style="display:grid; gap:8px; max-width:280px">
        <InputText @bind-Value="usuario.Login" placeholder="Usuário" />
        <InputText @bind-Value="usuario.Senha" placeholder="Senha" type="password" />
        <button type="submit">Entrar</button>
    </div>
</EditForm>

@code {
    private UsuarioLogin usuario = new();
    private string? erro;

    private void ValidarLogin()
    {
        if (usuario.Login == "est" && usuario.Senha == "est")
            Navigation.NavigateTo("/estacionamento", true);
        else
            erro = "Usuário ou senha inválidos (use est / est).";
    }

    public class UsuarioLogin
    {
        public string Login { get; set; } = string.Empty;
        public string Senha { get; set; } = string.Empty;
    }
}
